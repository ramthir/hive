#!/usr/bin/env python3
"""AWS Cost Explorer snapshots. stdlib only; credentials stay with AWS CLI."""
import argparse
from contextlib import contextmanager
from datetime import date, datetime, timedelta, timezone
from decimal import Decimal, InvalidOperation
import fcntl
import json
import os
from pathlib import Path
import re
import sqlite3
import subprocess
import tempfile


def aws(profile, *args):
    result = subprocess.run(['aws', '--profile', profile, '--no-cli-pager', *args, '--output', 'json'], capture_output=True, text=True)
    if result.returncode:
        raise ValueError('AWS request failed; check profile permissions and AWS CLI diagnostics separately')
    return json.loads(result.stdout)


def number(value):
    try:
        result = Decimal(str(value))
    except InvalidOperation:
        raise ValueError('Invalid AWS amount') from None
    if not result.is_finite():
        raise ValueError('Nonfinite reporting amount')
    return str(result)


def collect(profile, account, start, end, dashboard=False):
    token, seen, rows, periods = None, set(), {}, {}
    while True:
        args = ['ce', 'get-cost-and-usage', '--no-paginate', '--time-period', f'Start={start},End={end}',
                '--granularity', 'DAILY', '--metrics', 'UnblendedCost',
                *([] if dashboard else ['UsageQuantity']),
                '--group-by', 'Type=DIMENSION,Key=SERVICE',
                *([] if dashboard else ['Type=DIMENSION,Key=USAGE_TYPE']),
                '--filter', json.dumps({'Dimensions': {'Key': 'LINKED_ACCOUNT', 'Values': [account]}})]
        if token:
            args += ['--next-page-token', token]
        result = aws(profile, *args)
        for period in result['ResultsByTime']:
            day = period['TimePeriod']['Start']
            if not start <= day < end or period['TimePeriod']['End'] != (date.fromisoformat(day) + timedelta(days=1)).isoformat():
                raise ValueError('Unexpected AWS billing period')
            estimated = period['Estimated']
            if not isinstance(estimated, bool):
                raise ValueError('Invalid estimated flag')
            periods[day] = periods.get(day, False) or estimated
            for group in period['Groups']:
                if len(group['Keys']) != (1 if dashboard else 2):
                    raise ValueError('Unexpected AWS grouping')
                service = group['Keys'][0]
                usage_type = None if dashboard else group['Keys'][1]
                cost = group['Metrics']['UnblendedCost']
                usage = None if dashboard else group['Metrics'].get('UsageQuantity')
                if usage and not usage.get('Unit'):
                    usage = None
                row = {'date': day, 'service': service, 'usage_type': usage_type,
                       'amount': number(cost['Amount']), 'currency': cost['Unit'],
                       'quantity': number(usage['Amount']) if usage else None,
                       'unit': usage['Unit'] if usage else None}
                if dashboard:
                    row = {key: row[key] for key in ('date', 'service', 'amount', 'currency')}
                key = (day, service, row['currency']) if dashboard else (day, service, usage_type, row['currency'], row['unit'])
                if key in rows and rows[key] != row:
                    raise ValueError('Conflicting AWS records')
                rows[key] = row
        token = result.get('NextPageToken')
        if not token:
            break
        if token in seen:
            raise ValueError('Repeated pagination token')
        seen.add(token)
    expected = {(date.fromisoformat(start) + timedelta(days=i)).isoformat()
                for i in range((date.fromisoformat(end) - date.fromisoformat(start)).days)}
    if set(periods) != expected:
        raise ValueError('Incomplete daily AWS coverage')
    return list(rows.values()), [{'date': d, 'estimated': periods[d]} for d in sorted(periods)]


def atomic(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name)
    try:
        with os.fdopen(fd, 'w') as handle:
            json.dump(data, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


@contextmanager
def lock(path):
    path = Path(str(path) + '.lock')
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('AWS collection is already running') from None
        yield


def verify_account(profile, account):
    if aws(profile, 'sts', 'get-caller-identity')['Account'] != account:
        raise ValueError('Configured profile does not match the expected AWS account')


def cost_rows(rows):
    grouped = {}
    for row in rows:
        key = (row['date'], row['service'], row['currency'])
        grouped[key] = grouped.get(key, Decimal(0)) + Decimal(number(row['amount']))
    return [{'date': d, 'service': service, 'currency': currency, 'amount': str(value)}
            for (d, service, currency), value in sorted(grouped.items())]


class Cache:
    """Account/profile-scoped daily AWS cache; the lock includes freshness and fetches."""
    def __init__(self, path):
        path = Path(path).expanduser()
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.handle = Path(str(path) + '.lock').open('a')
        os.chmod(str(path) + '.lock', 0o600)
        fcntl.flock(self.handle, fcntl.LOCK_EX)
        self.db = None
        try:
            self.db = sqlite3.connect(path)
            os.chmod(path, 0o600)
            self.db.execute('CREATE TABLE IF NOT EXISTS days (account TEXT, profile TEXT, day TEXT, fetched REAL, estimated INTEGER, records TEXT, PRIMARY KEY(account,profile,day))')
        except (OSError, sqlite3.Error):
            if self.db is not None:
                self.db.close()
            self.handle.close()
            raise ValueError('AWS cache cannot be opened; check its path, permissions and format') from None

    def close(self):
        self.db.close()
        self.handle.close()

    def days(self, account, profile):
        return {day: {'fetched': fetched, 'estimated': bool(estimated), 'records': json.loads(records)}
                for day, fetched, estimated, records in self.db.execute(
                    'SELECT day,fetched,estimated,records FROM days WHERE account=? AND profile=? ORDER BY day', (account, profile))}

    def write(self, account, profile, updates):
        with self.db:
            self.db.executemany('INSERT OR REPLACE INTO days VALUES (?,?,?,?,?,?)',
                [(account, profile, day, value['fetched'], value['estimated'], json.dumps(value['records']))
                 for day, value in updates.items()])


def missing_ranges(days):
    ranges = []
    for day in days:
        if ranges and ranges[-1][1] == day:
            ranges[-1] = (ranges[-1][0], (date.fromisoformat(day) + timedelta(days=1)).isoformat())
        else:
            ranges.append((day, (date.fromisoformat(day) + timedelta(days=1)).isoformat()))
    return ranges


def sync_cached(profile, account, output, today, dashboard, cache_path, ttl, refresh):
    output = Path(output)
    first = today.replace(day=1)
    start, end = (first - timedelta(days=1)).replace(day=1), today
    attempt = datetime.now(timezone.utc)
    scope = 'dashboard_costs' if dashboard else 'general'
    with lock(output):
        cache = None
        try:
            cache = Cache(cache_path)
            verify_account(profile, account)
            previous = json.loads(output.read_text()) if output.exists() else None
            if previous and previous['account_id'] != account:
                raise ValueError('Snapshot belongs to another AWS account')
            if previous and previous.get('schema_version') not in (1, 2):
                raise ValueError('Unsupported existing snapshot')
            if previous and previous['schema_version'] == 2 and previous.get('report_scope') != 'dashboard_costs':
                raise ValueError('Unexpected snapshot scope')
            if previous and not dashboard and previous['schema_version'] != 1:
                raise ValueError('Dashboard snapshot cannot be used as a general reporting output')
            existing = cache.days(account, scope)
            if not existing and previous:
                # Seed the canonical cache without discarding previously collected history.
                seed_rows = cost_rows(previous['records']) if dashboard else previous['records']
                stamp = datetime.fromisoformat(previous['last_success_at'].replace('Z', '+00:00'))
                if stamp.tzinfo is None:
                    raise ValueError('Snapshot timestamp requires timezone')
                grouped = {}
                for row in seed_rows:
                    grouped.setdefault(row['date'], []).append(row)
                cache.write(account, scope, {day['date']: {'fetched': stamp.timestamp(),
                    'estimated': day['estimated'], 'records': grouped.get(day['date'], [])}
                    for day in previous['coverage']})
                existing = cache.days(account, scope)
            expected = [(start + timedelta(days=i)).isoformat() for i in range((end-start).days)]
            missing = [day for day in expected if refresh or day not in existing or attempt.timestamp()-existing[day]['fetched'] >= ttl]
            pending = {}
            for first_day, last_day in missing_ranges(missing):
                rows, coverage = collect(profile, account, first_day, last_day, dashboard=dashboard)
                grouped = {}
                for row in rows:
                    grouped.setdefault(row['date'], []).append(row)
                pending.update({day['date']: {'fetched': attempt.timestamp(),
                    'estimated': day['estimated'], 'records': grouped.get(day['date'], [])} for day in coverage})
            # No cache update occurs until every requested page/range has succeeded.
            cache.write(account, scope, pending)
            all_days = cache.days(account, scope)
            stop = end.isoformat()
            all_days = {day: value for day, value in all_days.items() if day < stop}
            last = min(all_days[day]['fetched'] for day in expected)
            snapshot = {'schema_version': 2 if dashboard else 1, 'account_id': account,
                'generated_at': attempt.isoformat(), 'last_success_at': datetime.fromtimestamp(last, timezone.utc).isoformat(),
                'start': min(all_days), 'end': stop,
                'records': [row for value in all_days.values() for row in value['records']],
                'coverage': [{'date': day, 'estimated': value['estimated']} for day,value in all_days.items()]}
            snapshot.update({'report_scope': 'dashboard_costs'} if dashboard else {'profile': profile})
            atomic(output, snapshot)
            atomic(str(output)+'.status.json', {'last_attempt_at': attempt.isoformat(), 'ok': True})
            return snapshot
        except Exception:
            atomic(str(output)+'.status.json', {'last_attempt_at': attempt.isoformat(), 'ok': False,
                'message': 'AWS collection failed; last successful data is retained.'})
            raise
        finally:
            if cache is not None:
                cache.close()


def sync(profile, account, output, today=None, dashboard=False, cache_path=None, ttl=86400, refresh=False):
    if not re.fullmatch(r'\d{12}', account):
        raise ValueError('Account must contain 12 digits')
    if not profile.strip():
        raise ValueError('Explicit AWS profile required')
    if ttl <= 0:
        raise ValueError('Cache TTL must be positive')
    today = today or datetime.now(timezone.utc).date()
    cache_path = cache_path or os.environ.get('AWS_CACHE',
        str(Path(os.environ.get('XDG_CACHE_HOME', str(Path.home()/'.cache'))) / 'hive/aws.sqlite3'))
    return sync_cached(profile, account, output, today, dashboard, cache_path, ttl, refresh)


def main():
    state = Path(os.environ.get("HIVE_STATE_DIR") or "~/.local/state/hive").expanduser() / "limark"
    parser = argparse.ArgumentParser(description="Publish AWS Cost Explorer billing data.")
    parser.add_argument("--profile", required=True)
    parser.add_argument("--account", required=True, help="Expected 12-digit AWS account")
    parser.add_argument("--output", default=os.environ.get("LIMARK_AWS_DASHBOARD_REPORT") or state / "aws-dashboard.json")
    parser.add_argument("--cache", default=state / "aws.sqlite3")
    parser.add_argument("--refresh", action="store_true", help="Refresh dates even when cached")
    args = parser.parse_args()
    try:
        sync(args.profile, args.account, Path(args.output).expanduser(), dashboard=True,
             cache_path=Path(args.cache).expanduser(), refresh=args.refresh)
    except (OSError, ValueError, KeyError, TypeError, sqlite3.Error, subprocess.SubprocessError) as error:
        parser.exit(1, f"AWS sync: {error}\n")


if __name__ == "__main__":
    main()
