NOTES_DIR=~/Workspace/notes
# PlantUML preview: a local JRE and plantuml.jar (no server needed). Leave unset to use `java` from PATH
# and ~/.local/share/hive/plantuml/plantuml.jar.
PLANTUML_JAVA=/path/to/java
PLANTUML_JAR=~/.local/share/hive/plantuml/plantuml.jar

# Set to 0 to turn off the file watcher (edits made outside Hive are then only seen after POST /api/reindex).
# HIVE_WATCH=0
# Path to Graphviz `dot` if it is not on PATH (only checked by /api/diagram/status).
# GRAPHVIZ_DOT=/path/to/dot
