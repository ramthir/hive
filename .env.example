NOTES_DIR=~/Workspace/notes
# PlantUML preview: a local JRE and plantuml.jar (no server needed). Leave unset to use `java` from PATH
# and ~/.local/share/hive/plantuml/plantuml.jar.
PLANTUML_JAVA=/path/to/java
PLANTUML_JAR=~/.local/share/hive/plantuml/plantuml.jar

# Set to 0 to turn off the file watcher (edits made outside Hive are then only seen after POST /api/reindex).
# HIVE_WATCH=0
# Path to Graphviz `dot` if it is not on PATH (only checked by /api/diagram/status).
# GRAPHVIZ_DOT=/path/to/dot

# Better commit messages: after each save, Codex reads the note's diff and replaces "doc: update Title" with a message
# about the change (in the background; the save does not wait). Off by default: the diff is sent to the model.
# HIVE_COMMIT_MESSAGES=codex
# HIVE_CODEX=/path/to/codex   # when it is not on PATH
# HIVE_CODEX_MODEL=           # empty: Codex's default
# HIVE_CODEX_EFFORT=          # reasoning effort (low, medium, high...); empty: Codex's default
# Model and effort for one feature only (they win over the two above): HIVE_CODEX_COMMIT_MODEL / _EFFORT for commit
# messages, HIVE_CODEX_CHAT_MODEL / _EFFORT for the chat.

# Agents page: path to `ccusage` when it is not on PATH (nvm and mise node installs are searched too).
# HIVE_CCUSAGE=/path/to/ccusage
# Agents quota rings: where the CLIs are when they are not on PATH or in ~/.local/bin, and Codex's session logs (fallback source).
# CLAUDE_BIN=/path/to/claude
# AGY_BIN=/path/to/agy
# CODEX_BIN=/path/to/codex
# CODEX_SESSIONS=~/.codex/sessions

# Colab tab: the `colab` CLI when it is not on PATH or in ~/.local/bin.
# COLAB_CLI_BIN=/path/to/colab

# Hive answers only requests whose Host is localhost, 127.0.0.1 or ::1 (no login). Extra names, comma separated:
# HIVE_ALLOWED_HOSTS=hive.local

# The chat runs Codex in NOTES_DIR with its own shell and NO sandbox (it cannot start in this container): publish the port as
# -p 127.0.0.1:80:80 so only this machine reaches it. The chat and the commit messages each keep one saved Codex session
# (HIVE_STATE_DIR/codex-sessions.json).

# Use Antigravity (agy) instead of Codex: HIVE_CHAT_AGENT=agy for the chat, HIVE_COMMIT_MESSAGES=agy for the commit messages.
# Its chat shell is unsandboxed too: keep the port on this machine. `agy models` lists the models.
# HIVE_CHAT_AGENT=agy
# HIVE_AGY=/path/to/agy            # when it is not on PATH or in ~/.local/bin
# HIVE_AGY_MODEL=                  # empty: agy's default
# HIVE_AGY_EFFORT=                 # low|medium|high|xhigh|max
# HIVE_AGY_CHAT_MODEL= / HIVE_AGY_CHAT_EFFORT= / HIVE_AGY_COMMIT_MODEL= / HIVE_AGY_COMMIT_EFFORT=   # per feature

# Use Claude Code (claude): HIVE_CHAT_AGENT=claude for the chat, HIVE_COMMIT_MESSAGES=claude for the commit messages.
# Its chat shell is unsandboxed too (--dangerously-skip-permissions): keep the port on this machine. The commit messages run with no tools.
# HIVE_CLAUDE=/path/to/claude      # when it is not on PATH or in ~/.local/bin
# HIVE_CLAUDE_MODEL=               # an alias (sonnet, haiku) or a full name; empty: claude's default
# HIVE_CLAUDE_EFFORT=              # low|medium|high|xhigh|max
# HIVE_CLAUDE_CHAT_MODEL= / HIVE_CLAUDE_CHAT_EFFORT= / HIVE_CLAUDE_COMMIT_MODEL= / HIVE_CLAUDE_COMMIT_EFFORT=   # per feature
