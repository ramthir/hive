NOTES_DIR=~/Workspace/notes
# PlantUML preview: a local JRE and plantuml.jar (no server needed). Leave unset to use `java` from PATH
# and ~/.local/share/hive/plantuml/plantuml.jar.
PLANTUML_JAVA=/path/to/java
PLANTUML_JAR=~/.local/share/hive/plantuml/plantuml.jar

# Set to 0 to turn off the file watcher (edits made outside Hive are then only seen after POST /api/reindex).
# HIVE_WATCH=0
# Path to Graphviz `dot` if it is not on PATH (only checked by /api/diagram/status).
# GRAPHVIZ_DOT=/path/to/dot

# Better commit messages: after each save, Codex reads the note's diff and replaces "doc: update Title" with a message
# about the change (in the background; the save does not wait). Off by default: the diff is sent to the model.
# HIVE_COMMIT_MESSAGES=codex
# HIVE_CODEX=/path/to/codex   # when it is not on PATH
# HIVE_CODEX_MODEL=           # empty: Codex's default
# HIVE_CODEX_EFFORT=          # reasoning effort (low, medium, high...); empty: Codex's default

# Agents page: path to `ccusage` when it is not on PATH (nvm and mise node installs are searched too).
# HIVE_CCUSAGE=/path/to/ccusage
